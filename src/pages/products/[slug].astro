---
// Product pages — one dossier template, three real products. Data lives in
// src/data/products.ts (single source of truth). Every image is a real
// asset, every string is real copy from CONTENT-SOURCE.md, all styling
// uses var(--qh-*) tokens only.
// Form number: the house's produce register runs 01/02/03 — pages take
// the letter (A/B/C) suffix so the site's document numbering stays honest.
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import ScrollProgress from '../../components/ScrollProgress.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Stamp from '../../components/Stamp.astro';
import Arrow from '../../components/Arrow.astro';
import { PRODUCTS, type Product } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };
const regNo = ['A', 'B', 'C'][PRODUCTS.findIndex((p) => p.slug === product.slug)] ?? 'A';
const formNo = `Form No. QH/03·${regNo} · Consignment dossier — ${product.name}`;

// The dossier shows its working: per-product methodology written ONLY from
// claims already in the data (no invented figures).
const methodLines: Record<string, string[]> = {
  'gum-arabic': [
    'Grading is by colour and clarity — the acacia’s own criteria, not ours.',
    'Batch grades are confirmed with the buyer before contract as a standing rule.',
    'Kibbled and mechanically processed states are sample-checked after processing.',
  ],
  cotton: [
    'Supervising begins at the field stage: sampling, reweighing and classing before any bale is committed.',
    'Classing and testing separate the crop by grade; results are documented first.',
  ],
  seeds: [
    'Improved and hybrid lines are documented per producer listing at the house.',
    'Producer access to technical knowledge is recorded as part of the consignment file.',
  ],
};
const method = methodLines[product.slug] ?? [];
---
<Base
  title={`${product.name} — Quality House Sudan`}
  description={product.lede}
  page={`product-${product.slug}`}
>
  <Cover />
  <ScrollProgress />
  <Nav />
  <main id="main">
    <!-- Chapter 01 — the cover of this dossier -->
    <section class="section product-cover" data-slug={product.slug}>
      <div class="container">
        <div class="form-head mono" data-reveal>
          <span>{formNo}</span>
          <span class="form-head-right">Rev. 2026</span>
        </div>

        <div class="cover-grid">
          <div class="cover-copy">
            <p class="eyebrow label">{product.eyebrow}</p>
            <h1 class="display-1" data-hero-line>{product.headline}</h1>
            <p class="lead" data-hero-fade>{product.lede}</p>
            <div class="cover-actions" data-hero-fade>
              <a class="btn btn--bronze" href="/#contact">Start an enquiry</a>
              <a class="btn" href="/#products">Back to the register</a>
            </div>
          </div>

          <div class="cover-sheet">
            <figure class="plate">
              <div class="duotone duotone--warm">
                <img
                  src={product.hero.src}
                  alt={product.hero.alt}
                  width="1200"
                  height="900"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
              <figcaption class="label">{product.hero.caption}</figcaption>
            </figure>
            <div class="cover-stamp" data-stamp>
              <Stamp size="5.5rem" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter 02 — the manifest of facts: one horizontal ledger -->
    <section class="section section--deck">
      <div class="container">
        <dl class="attr-list manifest mono" data-reveal>
          {product.facts.map((f) => (
            <div class="attr-item">
              <dt class="label attr-label">{f.label}</dt>
              <dd class="attr-value">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Chapter 03 — the clauses -->
    <section class="section">
      <div class="container">
        <ol class="chapter-list" role="list">
          {product.chapters.map((c, i) => (
            <li class="chapter" data-reveal>
              <span class="chapter-no mono">Clause {String(i + 1).padStart(2, '0')}</span>
              <h2 class="display-3">{c.title}</h2>
              <p>{c.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Chapter 04 — how this dossier is written (the honest working) -->
    <section class="section section--deck">
      <div class="container">
        <div class="method-wrap" data-reveal>
          <h3 class="display-3">How this dossier is written</h3>
          <ul class="method-list mono" role="list">
            {method.map((m) => <li>{m}</li>)}
          </ul>
          <p class="method-note mono">
            Specifications for a given shipment are confirmed with the buyer
            before contract. Anything not documented does not appear here.
          </p>
        </div>
      </div>
    </section>

    <!-- Closing — the instruction -->
    <section class="section">
      <div class="container product-close">
        <p class="lead" data-reveal>{product.closing}</p>
        <div class="close-actions" data-reveal>
          <a class="btn btn--bronze" href="/#contact">Start an enquiry <Arrow /></a>
          <a class="text-link" href="/#products">Back to all products</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .mono {
      font-family: var(--qh-font-mono);
      font-size: var(--qh-text-xs);
      font-variant-numeric: tabular-nums;
    }

    .product-cover {
      padding-block-start: calc(var(--qh-header-h) + var(--qh-s12));
      padding-block-end: var(--qh-s16);
    }

    .form-head {
      display: flex;
      justify-content: space-between;
      gap: var(--qh-s4);
      color: var(--qh-ink-mute);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding-block-end: var(--qh-s3);
      border-block-end: 1px solid var(--qh-line-strong);
      margin-block-end: var(--qh-s12);
    }

    .cover-grid {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: calc(var(--qh-s16) + var(--qh-s4));
      align-items: start;
    }

    .cover-copy {
      display: grid;
      gap: var(--qh-s8);
      justify-items: start;
    }

    .eyebrow { color: var(--qh-bronze-deep); }

    h1 {
      max-inline-size: 18ch;
      text-wrap: balance;
    }

    .cover-actions {
      display: flex;
      gap: var(--qh-s4);
      flex-wrap: wrap;
    }

    .cover-sheet {
      position: relative;
    }

    .plate {
      background: var(--qh-surface);
      border: 1px solid var(--qh-line);
      box-shadow: var(--qh-shadow-sheet);
    }

    .plate .duotone {
      aspect-ratio: 4 / 3;
    }

    /* The seeds dossier opens on a square specimen window — a different cut
       of the register row's plate (same real exposure, different framing),
       keeping every figure number single-owner in the registry. */
    [data-slug='seeds'] .plate .duotone {
      aspect-ratio: 1 / 1;
    }

    [data-slug='seeds'] .plate .duotone img {
      object-position: 30% 30%;
    }

    .plate figcaption {
      padding: var(--qh-s3) var(--qh-s4);
      border-block-start: 1px solid var(--qh-line);
    }

    .cover-stamp {
      position: absolute;
      inset-block-end: -1.25rem;
      inset-inline-end: -1.25rem;
    }

    /* --- Facts ledger -------------------------------------------------------------- */
    .manifest {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-block: 1px solid var(--qh-line-strong);
    }

    .attr-item {
      display: grid;
      gap: var(--qh-s1);
      align-content: start;
      padding: var(--qh-s6) var(--qh-s6) var(--qh-s6) 0;
    }

    .attr-item + .attr-item {
      border-inline-start: 1px solid var(--qh-line);
      padding-inline-start: var(--qh-s6);
    }

    .attr-value {
      color: var(--qh-ink);
      font-size: var(--qh-text-sm);
    }

    /* --- Clauses --------------------------------------------------------------------- */
    .chapter-list {
      display: grid;
    }

    .chapter {
      display: grid;
      grid-template-columns: minmax(7rem, auto) minmax(0, 1fr);
      gap: var(--qh-s8);
      align-items: start;
      max-inline-size: var(--qh-form-max);
      padding-block: var(--qh-s10);
      border-block-start: 1px solid var(--qh-line);
    }

    .chapter:last-child {
      border-block-end: 1px solid var(--qh-line);
    }

    .chapter-no {
      color: var(--qh-bronze-deep);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding-block-start: 0.4rem;
    }

    .chapter h2 {
      margin-block-end: var(--qh-s3);
    }

    .chapter p {
      color: var(--qh-ink-2);
      max-inline-size: var(--qh-measure);
      text-wrap: pretty;
    }

    /* --- Methodology ---------------------------------------------------------------------- */
    .method-wrap {
      border: 1px solid var(--qh-line-strong);
      background: var(--qh-surface);
      padding: clamp(1.5rem, 3vw, 2.5rem);
      display: grid;
      gap: var(--qh-s6);
      justify-items: start;
    }

    .method-list {
      display: grid;
      gap: var(--qh-s3);
      color: var(--qh-ink-2);
    }

    .method-list li {
      padding-inline-start: var(--qh-s5);
      border-inline-start: 3px solid var(--qh-bronze);
      max-inline-size: 64ch;
      text-wrap: pretty;
    }

    .method-note {
      color: var(--qh-ink-mute);
    }

    /* --- Closing ------------------------------------------------------------------------- */
    .product-close {
      display: grid;
      gap: var(--qh-s6);
      justify-items: start;
    }

    .close-actions {
      display: flex;
      gap: var(--qh-s6);
      align-items: center;
      flex-wrap: wrap;
    }

    @media (max-width: 980px) {
      .cover-grid {
        grid-template-columns: 1fr;
        gap: var(--qh-s12);
      }

      .cover-sheet {
        max-inline-size: 34rem;
      }

      .cover-stamp {
        inset-inline-end: 0.5rem;
        inset-block-end: 0.75rem;
      }

      .manifest {
        grid-template-columns: 1fr;
      }

      .attr-item + .attr-item {
        border-inline-start: none;
        border-block-start: 1px solid var(--qh-line);
        padding-inline-start: 0;
      }

      .chapter {
        grid-template-columns: 1fr;
        gap: var(--qh-s3);
      }

      .chapter-no {
        padding-block-start: 0;
      }
    }
  </style>
</Base>
