---
// Roots — Form No. QH/05, the house register. The people under the brand:
// founder, board, executive, team, named in one consistent register.
// Portraits from qualityhouseintl.com/organization (owner-authorized).
// The founder (late, 1967) has no published photo — named with role text
// only, never invented. v3's circular-crop card grid is retired: the
// register row is the dossier's way of naming people.
import Arrow from './Arrow.astro';

