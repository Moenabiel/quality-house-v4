---
// Shared arrow glyph for buttons and text links. Decorative (aria-hidden;
// link text carries the meaning). Sized in em so it tracks its parent.
---
<span class="btn-arrow" aria-hidden="true">
  <svg
    viewBox="0 0 20 20"
    width="1em"
    height="1em"
    fill="none"
    stroke="currentColor"
    stroke-width="1.35"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
  >
    <path d="M3 10h13M11.5 5.5 16 10l-4.5 4.5"></path>
  </svg>
</span>
