---
// Stamp — the recurring verification seal of the dossier. Bronze means
// VERIFIED: every stamp on screen must answer "what proves this?".
// SVG-native: currentColor only (token-driven from .stamp), arc text via
// textPath, and a subtle SVG-native ink-bleed (feTurbulence displacement).
// size: string — CSS grid size override, e.g. "5rem" (default 7.5rem).
interface Props {
  class?: string;
  size?: string;
  style?: string;
}
const { class: className, size, style } = Astro.props;
---

<span
  class:list={['stamp', 'stamp--bleed', className]}
  {...size ? { style: `${style ?? ''}inline-size:${size};block-size:${size}`.trim() } : { style }}
  aria-hidden="true"
>
  <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="stamp-bleed" x="-8%" y="-8%" width="116%" height="116%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.6" />
      </filter>
      <path id="stamp-arc-top" d="M 60 60 m -46 0 a 46 46 0 1 1 92 0" fill="none" />
      <path id="stamp-arc-bottom" d="M 60 60 m -46 0 a 46 46 0 1 0 92 0" fill="none" />
    </defs>

    <g filter="url(#stamp-bleed)">
      <!-- outer ring + inner ring -->
      <circle cx="60" cy="60" r="56" stroke="currentColor" stroke-width="2.4" />
      <circle cx="60" cy="60" r="37" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" />

      <!-- ring legend -->
      <text font-family="'IBM Plex Mono', monospace" font-size="8.4" letter-spacing="3.1"
        fill="currentColor" font-weight="600">
        <textPath href="#stamp-arc-top" startOffset="8%">QUALITY HOUSE · 1967 · PORT SUDAN</textPath>
      </text>
      <text font-family="'IBM Plex Mono', monospace" font-size="7.4" letter-spacing="2.6"
        fill="currentColor" font-weight="500">
        <textPath href="#stamp-arc-bottom" startOffset="24%">VERIFIED AT ORIGIN</textPath>
      </text>

      <!-- center monogram -->
      <text x="60" y="64" text-anchor="middle" dominant-baseline="middle"
        font-family="'IBM Plex Serif', serif" font-size="30" font-weight="600"
        fill="currentColor" letter-spacing="1">QH</text>

      <!-- under-rule -->
      <line x1="46" y1="76" x2="74" y2="76" stroke="currentColor" stroke-width="1.1" />
    </g>
  </svg>
</span>

<style is:global>
  /* filter id must stay unique even with multiple stamps on a page —
     the inline svg reuses one id; SVG resolves references per-document,
     which is fine for identical filters. */
</style>
