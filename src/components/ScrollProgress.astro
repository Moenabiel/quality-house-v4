---
// ScrollProgress — the dossier being read. A 2px hairline at the very top
// that fills with the house ink as the reader advances. Transform-only.
---
<div class="progress" aria-hidden="true">
  <span class="progress-fill" data-progress></span>
</div>

<style>
  .progress {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 2px;
    z-index: var(--qh-z-progress);
    pointer-events: none;
  }

  .progress-fill {
    display: block;
    block-size: 100%;
    background: var(--qh-green);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }
</style>
